  "HiggsfieldCampaign": {
    "title": "Marketing Studio \u00b7 Reference image",
    "endpoint": "marketing-studio/image",
    "kind": "image",
    "source": "https://dash.higgsfield.ai/models/marketing-studio/image/llms.txt",
    "schema": {
      "properties": {
        "prompt": {
          "type": "string",
          "maxLength": 5000
        },
        "image_url": {
          "type": "string",
          "format": "uri",
          "providerField": "image_urls",
          "asArray": true
        },
        "quality": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "default": "high"
        },
        "resolution": {
          "type": "string",
          "enum": ["1k", "2k", "4k"],
          "default": "2k"
        },
        "aspect_ratio": {
          "type": "string",
          "enum": [
            "auto",
            "1:1",
            "3:2",
            "2:3",
            "4:3",
            "3:4",
            "16:9",
            "9:16",
            "21:9"
          ],
          "default": "auto"
        },
        "reference_image_url": {
          "type": "string",
          "format": "uri",
          "providerField": "image_urls",
          "asArray": true
        },
        "image_urls": {
          "type": "string",
          "format": "uri-list",
          "default": "",
          "maxItems": 16,
          "maxLength": 32000,
          "tooltip": "One public HTTPS image reference or approved mhoo-asset token per line. Maximum 16, including the single reference inputs."
        }
      },
      "required": ["prompt"]
    }
  },
